[
  {"id": 37, "year": 1912, "date_original": "11 April 1912", "date_normalized": "1912-04-11", "date_conversion": "D Month YYYY -> YYYY-MM-DD。", "event": "第 1(b) 问：乘客 1,316 人，按性别与舱等分为头等 180 男/145 女=325、二等 179/106=285、三等 510/196=706。", "place_id": 5, "source_id": 1, "locator": "L5020-5030", "note": "与第 8 行的总数一致，此行补出性别细分。", "quote": "The total number of passengers was 1,316"},
  {"id": 38, "year": 1912, "date_original": "11 April 1912", "date_normalized": "1912-04-11", "date_conversion": "D Month YYYY -> YYYY-MM-DD。", "event": "第 2 问答复：泰坦尼克号离开皇后镇前符合 1894–1906 年商船法及其规则对客船与移民船的要求。", "place_id": 5, "source_id": 1, "locator": "L5035-5040", "note": "", "quote": "the requirements of the merchant shipping acts, 1894-1906"},
  {"id": 39, "year": 1912, "date_original": "1912", "date_normalized": "1912", "date_conversion": "仅给年份。", "event": "第 5(c) 问答复：船上从未举行过救生艇操演（boat drill）。", "place_id": 7, "source_id": 1, "locator": "L5054-5061", "note": "", "quote": "Had a boat drill been held on board"},
  {"id": 40, "year": 1912, "date_original": "1912", "date_normalized": "1912", "date_conversion": "仅给年份。", "event": "第 6 问答复：无线电为 Marconi 5 千瓦电动发电机组、两套完整设备、含独立应急蓄电池与线圈，设在艇甲板一舱室内；配 2 名操作员。", "place_id": 7, "source_id": 1, "locator": "L5065-5075", "note": "法庭认为操作员数目足以昼夜连续收发。", "quote": "A Marconi 5-kilowatt motor generator"},
  {"id": 41, "year": 1912, "date_original": "1912", "date_normalized": "1912", "date_conversion": "仅给年份。", "event": "第 7(a) 问答复：启航前未给船长特别航行指示，只依公司《规则与条例》的一般指示。", "place_id": 7, "source_id": 1, "locator": "L5077-5087", "note": "法庭认为若就遇冰时应采的航向有所交代会更好。", "quote": "No special instructions were given"},
  {"id": 42, "year": 1912, "date_original": "1912", "date_normalized": "1912", "date_conversion": "仅给年份。", "event": "第 8(d) 问答复：Smith 船长对航线有自由裁量权，不受必须在航路上的命令束缚。", "place_id": 7, "source_id": 1, "locator": "L5089-5111", "note": "", "quote": "Capt. Smith was not fettered by any"},
  {"id": 43, "year": 1912, "date_original": "14 April 1912", "date_normalized": "1912-04-14", "date_conversion": "D Month YYYY -> YYYY-MM-DD。", "event": "第 9(c) 问答复：泰坦尼克号收到多份冰情电报，但航向的改变并非因这些冰情所致。", "place_id": 7, "source_id": 1, "locator": "L5113-5125", "note": "", "quote": "but not in consequence of the information received as to ice"},
  {"id": 44, "year": 1912, "date_original": "14 April 1912 12:55 p.m.", "date_normalized": "1912-04-14T12:55", "date_conversion": "时间转 24 小时制。", "event": "泰坦尼克号于下午 12:55 复电 Baltic 号：「谢谢来电与祝福，离港后天气良好。」署名 SMITH。", "place_id": 7, "source_id": 1, "locator": "L5128-5136", "note": "", "quote": "Had fine weather since leaving."},
  {"id": 45, "year": 1912, "date_original": "14 April 1912 1:26 p.m.", "date_normalized": "1912-04-14T13:26", "date_conversion": "时间转 24 小时制。", "event": "泰坦尼克号于下午 1:26 复电 Caronia 号：「谢谢来电与消息，天气一直多变。」署名 SMITH。", "place_id": 7, "source_id": 1, "locator": "L5140-5149", "note": "", "quote": "Have had variable weather"},
  {"id": 46, "year": 1912, "date_original": "14 April 1912 9:30 p.m.", "date_normalized": "1912-04-14T21:30", "date_conversion": "时间转 24 小时制（船时）。", "event": "第 10 问答复：本可预期在当晚 9:30 或更早遇冰；瞭望不足，宜在船首再加一人并从驾驶台两侧加派军官；且始终未下令减速。", "place_id": 17, "source_id": 1, "locator": "L5153-5171", "note": "法庭明确判定瞭望「不充分」。", "quote": "At, or even before, 9.30 p.m. ship's time"},
  {"id": 47, "year": 1912, "date_original": "1912", "date_normalized": "1912", "date_conversion": "仅给年份。", "event": "第 11 问答复：瞭望员未获配双筒望远镜，也未使用；船上无探照灯，故亦未用；法庭认为此种情况下望远镜与探照灯并非必需。", "place_id": 7, "source_id": 1, "locator": "L5173-5181", "note": "法庭补充：探照灯有时或有帮助，但证据不足以作更精确答复。", "quote": "Were binoculars provided for and used by the lookout men"},
  {"id": 48, "year": 1912, "date_original": "14 April 1912", "date_normalized": "1912-04-14", "date_conversion": "D Month YYYY -> YYYY-MM-DD。", "event": "第 12 问答复：已特别叮嘱瞭望员注意小块浮冰与 growlers，并关闭前舱口盖（fore-scuttle hatch）使驾驶台前保持黑暗；法庭认为这些属通常做法，但有人认为应另在船首设瞭望。", "place_id": 7, "source_id": 1, "locator": "L5183-5192", "note": "", "quote": "the fore-scuttle hatch was closed"},
  {"id": 49, "year": 1912, "date_original": "14 April 1912", "date_normalized": "1912-04-14T22:00", "date_conversion": "时间转 24 小时制；Q14 未指明具体时刻，此处标注事发前航速时段。", "event": "第 14 问答复：撞击前与撞击时航速约 22 节；法庭判定该航速在此情况下过快（excessive）。", "place_id": 7, "source_id": 1, "locator": "L5203-5207", "note": "", "quote": "About 22 knots"},
  {"id": 50, "year": 1912, "date_original": "14 April 1912", "date_normalized": "1912-04-14", "date_conversion": "D Month YYYY -> YYYY-MM-DD。", "event": "第 15(a) 问答复：事故为与冰山碰撞，冰山在吃水线以下多处刺穿右舷，范围自前尖舱至 4 号锅炉舱之间。", "place_id": 8, "source_id": 1, "locator": "L5209-5216", "note": "第 16 行所记受损舱室为前尖舱、1–3 号货舱、5 与 6 号锅炉舱，措辞略异，并存。", "quote": "between the forepeak tank and No. 4 boiler room"},
  {"id": 51, "year": 1912, "date_original": "14 April 1912 11:40 p.m.", "date_normalized": "1912-04-14T23:40", "date_conversion": "时间转 24 小时制。", "event": "第 16(a) 问答复：事故后立即自驾驶台关闭机舱与锅炉舱的 12 道水密门，抽掉部分锅炉火，并启动 6 号锅炉舱之后的舱底水泵。", "place_id": 8, "source_id": 1, "locator": "L5218-5226", "note": "", "quote": "The 12 water-tight doors in the engine and boiler rooms"},
  {"id": 52, "year": 1912, "date_original": "14 April 1912", "date_normalized": "1912-04-14T23:55", "date_conversion": "原文「about 15 to 20 minutes」为相对时间，按撞击约 11:40 折算为约 11:55–12:00。", "event": "第 16(b) 问答复：船上负责人约在事故后 15 至 20 分钟才意识到严重性。", "place_id": 8, "source_id": 1, "locator": "L5226-5227", "note": "折算时刻为本文推定，非原文直述。", "quote": "About 15 to 20 minutes"},
  {"id": 53, "year": 1912, "date_original": "15 April 1912", "date_normalized": "1912-04-15", "date_conversion": "D Month YYYY -> YYYY-MM-DD。", "event": "第 16(d) 问答复：18 艘救生艇被吊出并降下，其余 2 艘随船漂离后被用作筏。", "place_id": 8, "source_id": 1, "locator": "L5231-5234", "note": "", "quote": "Eighteen of the boats were swung out and lowered"},
  {"id": 54, "year": 1912, "date_original": "15 April 1912", "date_normalized": "1912-04-15", "date_conversion": "D Month YYYY -> YYYY-MM-DD。", "event": "第 17 问答复：事故后船上保持了良好的纪律。", "place_id": 7, "source_id": 1, "locator": "L5236-5239", "note": "", "quote": "Was proper discipline maintained on board"},
  {"id": 55, "year": 1912, "date_original": "15 April 1912", "date_normalized": "1912-04-15", "date_conversion": "D Month YYYY -> YYYY-MM-DD。", "event": "第 18(g) 问答复：并无任何错误电报；一些船只未前往只是因距离过远。", "place_id": 7, "source_id": 1, "locator": "L5255-5257", "note": "", "quote": "There were no erroneous messages."},
  {"id": 56, "year": 1912, "date_original": "15 April 1912 12:25 a.m.", "date_normalized": "1912-04-15T00:25", "date_conversion": "无线电记录以 New York time 10.35 p.m. 对应 Titanic time 12.25 a.m.；此处采用船时转 24 小时制。", "event": "无线电记录：Carpathia 号于船时约 12:25 a.m. 收到泰坦尼克号 CQD：「Come at once. We have struck a berg. It's a CQD. Position 41.46 N., 50.14 W.」。", "place_id": 8, "source_id": 1, "locator": "L5279-5282", "note": "同一表内另有 41.44 N. 的较早位置，属修订前的报位。", "quote": "Come at once. We have"},
  {"id": 57, "year": 1912, "date_original": "15 April 1912", "date_normalized": "1912-04-15", "date_conversion": "D Month YYYY -> YYYY-MM-DD。", "event": "第 21(c) 问：头等舱获救 203 人 / 325 人，占 62.46%（成年男 57/175、成年女 140/144、男童 5、女童 1）。", "place_id": 7, "source_id": 1, "locator": "L5619-5626", "note": "", "quote": "203 out of 325, or 62.46 per cent"},
  {"id": 58, "year": 1912, "date_original": "15 April 1912", "date_normalized": "1912-04-15", "date_conversion": "D Month YYYY -> YYYY-MM-DD。", "event": "第 21(c) 问：二等舱获救 118 人 / 285 人，占 41.40%（成年男 14/168、成年女 80/93、男童 11、女童 13）。", "place_id": 7, "source_id": 1, "locator": "L5627-5634", "note": "", "quote": "118 out of 285, or 41.40 per cent"},
  {"id": 59, "year": 1912, "date_original": "15 April 1912", "date_normalized": "1912-04-15", "date_conversion": "D Month YYYY -> YYYY-MM-DD。", "event": "第 21(c) 问：三等舱获救 178 人 / 706 人，占 25.21%（成年男 75/462、成年女 76/165、男童 13/48、女童 14/31）。", "place_id": 7, "source_id": 1, "locator": "L5635-5642", "note": "", "quote": "178 out of 706, or 25.21 per cent"},
  {"id": 60, "year": 1912, "date_original": "15 April 1912", "date_normalized": "1912-04-15", "date_conversion": "D Month YYYY -> YYYY-MM-DD。", "event": "第 21(d) 问：船员获救 212 人 / 885 人，占 23.95%——甲板部 43/66、轮机部 72/325、事务部 97/494（内女性 20/23）。", "place_id": 7, "source_id": 1, "locator": "L5646-5653", "note": "", "quote": "212 out of 885, or 23.95 per cent"},
  {"id": 61, "year": 1912, "date_original": "15 April 1912", "date_normalized": "1912-04-15", "date_conversion": "D Month YYYY -> YYYY-MM-DD。", "event": "报告另按性别统计获救比例：成年男 338/1,667（20.27%）、成年女 316/425（74.35%）、儿童 57/109（52.29%）。", "place_id": 7, "source_id": 1, "locator": "L3286-3291", "note": "与第 27 行总数 711/2,201 一致。", "quote": "338 out of 1,667, or 20.27 per cent"},
  {"id": 62, "year": 1912, "date_original": "15 April 1912", "date_normalized": "1912-04-15", "date_conversion": "D Month YYYY -> YYYY-MM-DD。", "event": "第 21(f) 问：各等舱获救比例悬殊，主因是舱位位置不同与三等舱多外国人；法庭认为绝非军官或船员有意偏袒。", "place_id": 7, "source_id": 1, "locator": "L5657-5666", "note": "", "quote": "many of the third-class passengers were foreigners"},
  {"id": 63, "year": 1912, "date_original": "11 April 1912", "date_normalized": "1912-04-11", "date_conversion": "D Month YYYY -> YYYY-MM-DD。", "event": "第 25 问答复：泰坦尼克号离皇后镇时作为大西洋航线的客船与移民船，建造妥善、装备充足。", "place_id": 5, "source_id": 1, "locator": "L5692-5696", "note": "", "quote": "adequately equipped as a passenger steamer and"},
  {"id": 64, "year": 1912, "date_original": "30 July 1912", "date_normalized": "1912-07-30", "date_conversion": "报告署期「JULY 30, 1912」-> YYYY-MM-DD。", "event": "建议 1：新设的舱壁委员会应研究并报告为船舶提供双层船壳、或两侧纵向水密舱壁、或二者组合的可行性与必要性（均须另加水密横舱壁）。", "place_id": 9, "source_id": 1, "locator": "L5719-5728", "note": "", "quote": "double skin carried up above the water"},
  {"id": 65, "year": 1912, "date_original": "30 July 1912", "date_normalized": "1912-07-30", "date_conversion": "报告署期 -> YYYY-MM-DD。", "event": "建议 3：委员会应通盘研究以加强分舱保护，目的在于使船舶在最大可行长度与海相通时仍能浮航。", "place_id": 9, "source_id": 1, "locator": "L5739-5743", "note": "", "quote": "the practicability of increasing the protection given by subdivision"},
  {"id": 66, "year": 1912, "date_original": "30 July 1912", "date_normalized": "1912-07-30", "date_conversion": "报告署期 -> YYYY-MM-DD。", "event": "建议 5：立法应授权贸易委员会要求提交所有在建船舶的设计与规格，并可就海上人命安全指示其修改。", "place_id": 9, "source_id": 1, "locator": "L5752-5756", "note": "适用于一切载客船。", "quote": "require the production of the designs and specifications"},
  {"id": 67, "year": 1912, "date_original": "30 July 1912", "date_normalized": "1912-07-30", "date_conversion": "报告署期 -> YYYY-MM-DD。", "event": "建议 6：救生艇与筏的配备应依船上预载人数，而非按吨位计算。", "place_id": 9, "source_id": 1, "locator": "L5761-5763", "note": "", "quote": "based on the number of persons intended to be carried"},
  {"id": 68, "year": 1912, "date_original": "30 July 1912", "date_normalized": "1912-07-30", "date_conversion": "报告署期 -> YYYY-MM-DD。", "event": "建议 7：救生艇配备问题应与船体分舱问题分开处理；这意味着废止 1902 年救生设备规则的 rule 12。", "place_id": 9, "source_id": 1, "locator": "L5765-5768", "note": "", "quote": "abolition of rule 12 of the"},
  {"id": 69, "year": 1912, "date_original": "30 July 1912", "date_normalized": "1912-07-30", "date_conversion": "报告署期 -> YYYY-MM-DD。", "event": "建议 8：救生艇配备应足以容纳船上所有人；特殊情形经贸易委员会认可可酌减。", "place_id": 9, "source_id": 1, "locator": "L5770-5780", "note": "或需改变艇型尺寸与吊放方式，并专设艇甲板用于载艇与操演。", "quote": "sufficient for all persons on board"},
  {"id": 70, "year": 1912, "date_original": "30 July 1912", "date_normalized": "1912-07-30", "date_conversion": "报告署期 -> YYYY-MM-DD。", "event": "建议 9：所有救生艇应装设连续的护舷物（fender），以减小在风浪中降放时受损的风险。", "place_id": 9, "source_id": 1, "locator": "L5782-5783", "note": "", "quote": "protective continuous fender"},
  {"id": 71, "year": 1912, "date_original": "30 July 1912", "date_normalized": "1912-07-30", "date_conversion": "报告署期 -> YYYY-MM-DD。", "event": "建议 10：应授权贸易委员会要求一艘或多艘救生艇装设某种机械推进装置。", "place_id": 9, "source_id": 1, "locator": "L5785-5786", "note": "", "quote": "some form of mechanical propulsion"},
  {"id": 72, "year": 1912, "date_original": "30 July 1912", "date_normalized": "1912-07-30", "date_conversion": "报告署期 -> YYYY-MM-DD。", "event": "建议 11：应立规要求船舶离港时艇上即配齐设备；艇与筏应带灯与烟火信号，配罗经与给养，并清楚标示可载成人数。", "place_id": 9, "source_id": 1, "locator": "L5788-5797", "note": "", "quote": "as soon as the ship leaves harbor"},
  {"id": 73, "year": 1912, "date_original": "30 July 1912", "date_normalized": "1912-07-30", "date_conversion": "报告署期 -> YYYY-MM-DD。", "event": "建议 12：贸易委员会对救生艇与救生设备的检查应比以往更严格。", "place_id": 9, "source_id": 1, "locator": "L5799-5800", "note": "", "quote": "inspection of boats and life-saving"},
  {"id": 74, "year": 1912, "date_original": "30 July 1912", "date_normalized": "1912-07-30", "date_conversion": "报告署期 -> YYYY-MM-DD。", "event": "建议 13：若甲板人手不足，应由受过艇务训练的船员补足，且这些人须通过艇务测试。", "place_id": 9, "source_id": 1, "locator": "L5805-5808", "note": "", "quote": "not sufficient to man the"},
  {"id": 75, "year": 1912, "date_original": "30 July 1912", "date_normalized": "1912-07-30", "date_conversion": "报告署期 -> YYYY-MM-DD。", "event": "建议 14：鉴于需有受过艇务训练的人手，应设法鼓励为商船队培训少年。", "place_id": 9, "source_id": 1, "locator": "L5810-5812", "note": "", "quote": "training of boys for the merchant service"},
  {"id": 76, "year": 1912, "date_original": "30 July 1912", "date_normalized": "1912-07-30", "date_conversion": "报告署期 -> YYYY-MM-DD。", "event": "建议 16：艇务操演应更频繁；船舶离港后应尽快举行救生艇、消防与水密门操演，航程中至少每周一次，并记入航海日志。", "place_id": 9, "source_id": 1, "locator": "L5818-5823", "note": "", "quote": "fire drill, and a"},
  {"id": 77, "year": 1912, "date_original": "30 July 1912", "date_normalized": "1912-07-30", "date_conversion": "报告署期 -> YYYY-MM-DD。", "event": "建议 17：船舶离港前，贸易委员会应确认已拟定一套有效运用救生艇的方案并传达给每位军官。", "place_id": 9, "source_id": 1, "locator": "L5825-5827", "note": "", "quote": "a scheme has been devised"},
  {"id": 78, "year": 1912, "date_original": "30 July 1912", "date_normalized": "1912-07-30", "date_conversion": "报告署期 -> YYYY-MM-DD。", "event": "建议 18：担任瞭望者应每隔适当时间接受视力测试。", "place_id": 9, "source_id": 1, "locator": "L5832-5833", "note": "", "quote": "undergo a sight test"},
  {"id": 79, "year": 1912, "date_original": "30 July 1912", "date_normalized": "1912-07-30", "date_conversion": "报告署期 -> YYYY-MM-DD。", "event": "建议 19：船舶应建立警务/秩序体系，以确保紧急时听从命令、妥善管控与引导全船人员。", "place_id": 9, "source_id": 1, "locator": "L5835-5837", "note": "", "quote": "a police system should be organized"},
  {"id": 80, "year": 1912, "date_original": "30 July 1912", "date_normalized": "1912-07-30", "date_conversion": "报告署期 -> YYYY-MM-DD。", "event": "建议 20：船舶应装设无线电，并配足够受训操作员以保证昼夜连续服务；可行时设静音收报室。", "place_id": 9, "source_id": 1, "locator": "L5839-5846", "note": "参照 Sir H. Babington Smith 主持的国际无线电报会议决议。", "quote": "continuous service by"},
  {"id": 81, "year": 1912, "date_original": "30 July 1912", "date_normalized": "1912-07-30", "date_conversion": "报告署期 -> YYYY-MM-DD。", "event": "建议 21：应在各轮船公司规章中规定，当航路上或附近报告有冰时，船舶在夜暗时段应中速航行或改向以远离危险区。", "place_id": 9, "source_id": 1, "locator": "L5848-5851", "note": "", "quote": "should proceed in the dark hours at a moderate speed"},
  {"id": 82, "year": 1912, "date_original": "30 July 1912", "date_normalized": "1912-07-30", "date_conversion": "报告署期 -> YYYY-MM-DD。", "event": "建议 22：应提醒船长，依 1911 年海事公约法，可行时不对遇难船施救构成轻罪。", "place_id": 9, "source_id": 1, "locator": "L5853-5856", "note": "", "quote": "not to go to the relief of a vessel in"},
  {"id": 83, "year": 1912, "date_original": "30 July 1912", "date_normalized": "1912-07-30", "date_conversion": "报告署期 -> YYYY-MM-DD。", "event": "建议 23：移民船经监督与检查所获的人命安全保障，应扩及所有外洋客船。", "place_id": 9, "source_id": 1, "locator": "L5858-5860", "note": "", "quote": "extended to all foreign-going passenger ships"},
  {"id": 84, "year": 1912, "date_original": "30 July 1912", "date_normalized": "1912-07-30", "date_conversion": "报告署期 -> YYYY-MM-DD。", "event": "建议 24：应召开国际会议，就分舱、救生设备与其操作、无线电装设与操作、近冰减速或改向、探照灯使用等方面取得共同行为准则。", "place_id": 9, "source_id": 1, "locator": "L5862-5868", "note": "", "quote": "call an international conference"},
  {"id": 85, "year": 1912, "date_original": "14 April 1912 11:40 p.m.", "date_normalized": "1912-04-14T23:40", "date_conversion": "时间转 24 小时制。", "event": "碰撞经过：瞭望员先敲三下警钟、再以电话报「Iceberg right ahead」；Murdoch 立即令「Hard-a-starboard」并电报机舱「Stop. Full speed astern」；右舷约在转舵 37 秒、行进 466 码后撞上冰山，据此推算冰山约在 500 码外被发现。", "place_id": 8, "source_id": 1, "locator": "L2393-2425", "note": "500 码为报告据 Olympic 实验的推算值，非观测值。", "quote": "500 yards was about the distance"},
  {"id": 86, "year": 1912, "date_original": "15 April 1912", "date_normalized": "1912-04-15", "date_conversion": "D Month YYYY -> YYYY-MM-DD。", "event": "报告结论：4 号锅炉舱之后的舱室没有受损。", "place_id": 8, "source_id": 1, "locator": "L2582-2583", "note": "", "quote": "there was no damage abaft No. 4"},
  {"id": 87, "year": 1912, "date_original": "14 April 1912 11:40 p.m.", "date_normalized": "1912-04-14T23:40", "date_conversion": "时间转 24 小时制。", "event": "以 20 节以上速度，船通过 300 英尺不到 10 秒，故破损约在 10 秒内造成。", "place_id": 8, "source_id": 1, "locator": "L2458-2462", "note": "", "quote": "the damage was done in about"},
  {"id": 88, "year": 1912, "date_original": "15 April 1912", "date_normalized": "1912-04-15", "date_conversion": "D Month YYYY -> YYYY-MM-DD。", "event": "报告分析：该船分舱可承受任意两舱进水；四间前部舱室进水仍可不沉，但连 6 号锅炉舱在内共五舱进水即无法不沉。", "place_id": 8, "source_id": 1, "locator": "L2632-2657", "note": "说明舱壁未到顶导致逐舱越流致沉。", "quote": "could not remain afloat with the four compartments and the"},
  {"id": 89, "year": 1912, "date_original": "1912", "date_normalized": "1912", "date_conversion": "仅给年份。", "event": "救生艇规格：14 艘木制救生艇各长 30 英尺、宽 9 英尺 1 英寸、深 4 英尺，容积 655.2 立方英尺，载 65 人；4 艘 Engelhardt 折叠艇各长 27 英尺 5 英寸、宽 8 英尺、深 3 英尺，容积 376.6 立方英尺，载 47 人。", "place_id": null, "source_id": 1, "locator": "L1360-1381", "note": "全船艇只总容积 11,327.9 立方英尺，共载 1,178 人。", "quote": "Four Engelhardt collapsible boats"},
  {"id": 90, "year": 1912, "date_original": "1912", "date_normalized": "1912", "date_conversion": "仅给年份。", "event": "遇险信号配备：36 枚 socket signals（代替礼炮）、12 枚普通火箭、2 具 Manwell Holmes 甲板火焰信号、12 盏蓝灯、6 盏救生圈灯，数目与式样均经贸易委员会核准。", "place_id": null, "source_id": 1, "locator": "L1439-1442", "note": "", "quote": "36 socket signals"},
  {"id": 91, "year": 1912, "date_original": "1912", "date_normalized": "1912", "date_conversion": "仅给年份。", "event": "双层底由 17 道横向水密隔壁（含首尾尖舱）及中心纵隔壁、两道纵隔壁，分为 46 个舱；其中 6 个专作淡水舱。", "place_id": null, "source_id": 1, "locator": "L1458-1464", "note": "此「17 道」指双层底内的横向分舱，与第 4 行船体「15 道横向水密舱壁」是两套不同系统，非矛盾。", "quote": "into 46 compartments"},
  {"id": 92, "year": 1912, "date_original": "1912", "date_normalized": "1912", "date_conversion": "仅给年份。", "event": "自 1899 年起，北大西洋各大轮船公司依共同协议采用随季节调整的航路（lane routes），以避开雾与冰多发区并保持进出港船流分离。", "place_id": 7, "source_id": 1, "locator": "L1875-1890", "note": "航线经海道测量局与海军部航路图公布，并载入航海指南。", "quote": "since 1899, the practice"},
  {"id": 93, "year": 1912, "date_original": "April 1912", "date_normalized": "1912-04", "date_conversion": "Month YYYY -> YYYY-MM。", "event": "该出港南线约在图上「三月至七月有整片浮冰」区以南 25 英里处通过，却在「四、五、六月经见此线内有冰山」虚线以北 100 至 300 英里。", "place_id": 7, "source_id": 1, "locator": "L1900-1904", "note": "说明习惯航线仍穿越冰山带。", "quote": "about 25 miles south"},
  {"id": 94, "year": 1912, "date_original": "5 April 1912", "date_normalized": "1912-04-05", "date_conversion": "D Month YYYY -> YYYY-MM-DD。", "event": "Californian 号详情：Leyland 公司，船长 Stanley Lord；4 月 5 日离伦敦，4 月 19 日抵波士顿；6,223 总吨、4,038 净吨，全速 12.5–13 节；有客船证书但当时未载客；属 International Mercantile Marine Co.（与泰坦尼克同一母公司）。", "place_id": 16, "source_id": 1, "locator": "L3302-3308", "note": "", "quote": "6,223 tons gross and 4,038 net"},
  {"id": 95, "year": 1912, "date_original": "14 April 1912 7:30 p.m.", "date_normalized": "1912-04-14T19:30", "date_conversion": "时间转 24 小时制（船时）。", "event": "Californian 号于晚 7:30 致电 Antillian 号：六时三十分船时，位于北纬 42°3'、西经 49°9'，南面 5 英里有三座大冰山；该电被泰坦尼克号截获，其报务员答「已收到」。", "place_id": 7, "source_id": 1, "locator": "L3310-3330", "note": "此为泰坦尼克号当晚收到冰情之一。", "quote": "Three large bergs, 5 miles to southward"},
  {"id": 96, "year": 1912, "date_original": "14 April 1912 10:20 p.m.", "date_normalized": "1912-04-14T22:20", "date_conversion": "时间转 24 小时制（船时）。", "event": "Californian 号沿 S. 89°W 航至晚 10:20 因驶入整片浮冰而停车倒车；船长称当时位置为北纬 42°5'、西经 57°7'，法庭认为该位置不准确。", "place_id": 7, "source_id": 1, "locator": "L3332-3343", "note": "法庭明确表示该推算位置不可靠；航海日志由大副据 scrap log 誊录，而 scrap log 已毁。", "quote": "running into field ice"},
  {"id": 97, "year": 1912, "date_original": "14 April 1912 11:00 p.m.", "date_normalized": "1912-04-14T23:00", "date_conversion": "时间转 24 小时制（船时）。", "event": "约晚 11 时 Californian 号见一艘汽船自东侧驶近，初距 6–7 英里，11 时半约 5 英里；三副 Groves 确信来船是客船（「灯光很多」），但船长当时并不在驾驶台。", "place_id": 7, "source_id": 1, "locator": "L3348-3398", "note": "该「来船」后被认为是泰坦尼克号。", "quote": "a lot of light"}
]
